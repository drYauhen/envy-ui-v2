{
  "name": "envy-ui-v2",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "docs:copy": "node scripts/copy-docs-to-public.mjs",
    "docs:watch": "nodemon --watch docs --ext md --exec \"npm run docs:copy\"",
    "docs:validate": "node scripts/validate-docs-links.mjs",
    "docs:generate-ids": "node scripts/generate-doc-ids.mjs",
    "docs:format-headers": "node scripts/format-doc-headers.mjs",
    "docs:regenerate-data": "node scripts/generate-unified-doc-data.mjs all",
    "docs:regenerate-all": "node scripts/generate-unified-doc-data.mjs all --stories",
    "adr:generate": "node scripts/generate-adr-stories.mjs",
    "adr:validate": "node scripts/validate-adr.mjs",
    "tokens:build:sd": "style-dictionary build --config style-dictionary/config.mjs",
    "tokens:build": "npm run tokens:build:sd && npm run tokens:build:canonical",
    "tokens:build:storybook": "STYLE_DICTIONARY_TARGET=storybook npm run tokens:build:sd",
    "tokens:build:dev-app": "STYLE_DICTIONARY_TARGET=dev-app npm run tokens:build:sd",
    "tokens:build:dev-app:resolver": "npm run tokens:build:dev-app",
    "tokens:build:website-app": "STYLE_DICTIONARY_TARGET=website-app npm run tokens:build:sd",
    "tokens:build:report-app": "STYLE_DICTIONARY_TARGET=report-app npm run tokens:build:sd",
    "tokens:build:all-targets": "npm run tokens:build:dev-app && npm run tokens:build:website-app && npm run tokens:build:report-app && npm run tokens:build:storybook && npm run tokens:build:canonical",
    "tokens:build:canonical": "npm run tokens:build:canonical:sd",
    "tokens:build:canonical:sd": "STYLE_DICTIONARY_TARGET=dev-app npx style-dictionary build --config style-dictionary/config.mjs --platform canonicalPrimitives && STYLE_DICTIONARY_TARGET=dev-app npx style-dictionary build --config style-dictionary/config.mjs --platform canonicalContexts && STYLE_DICTIONARY_TARGET=dev-app npx style-dictionary build --config style-dictionary/config.mjs --platform canonicalThemes && STYLE_DICTIONARY_TARGET=dev-app npx style-dictionary build --config style-dictionary/config.mjs --platform canonicalEntrypoint",
    "tokens:build:canonical:legacy": "node scripts/generate-canonical-css.mjs",
    "resolver:generate:app": "node scripts/generate-app-resolver-phase1.mjs",
    "resolver:validate:app": "node scripts/validate-app-resolver-phase1.mjs",
    "resolver:resolve:app": "node scripts/resolve-resolver-order.mjs --resolver tokens/knowledge/resolver/app-core.resolver.json",
    "resolver:compare:app": "node scripts/compare-app-resolver-legacy-phase2.mjs",
    "resolver:verify:canonical-parity": "node scripts/verify-canonical-resolver-parity.mjs",
    "resolver:verify:canonical-sd-parity": "node scripts/verify-canonical-sd-parity.mjs",
    "resolver:generate:phase4": "node scripts/generate-resolver-phase4.mjs",
    "resolver:validate:phase4": "node scripts/validate-resolver-phase4.mjs",
    "resolver:check": "npm run resolver:validate:app && npm run resolver:validate:phase4",
    "tokens:build:tokenstudio": "style-dictionary build --config style-dictionary/config.mjs --platform tokenstudio",
    "tokens:build:figma": "npm run tokens:build:figma:app && npm run tokens:build:figma:website && npm run tokens:build:figma:report",
    "tokens:build:figma:app": "style-dictionary build --config style-dictionary/config.mjs --platform figmaApp",
    "tokens:build:figma:website": "style-dictionary build --config style-dictionary/config.mjs --platform figmaWebsite",
    "tokens:build:figma:report": "style-dictionary build --config style-dictionary/config.mjs --platform figmaReport",
    "tokens:copy-readme": "node scripts/copy-tokens-readme.mjs",
    "tokens:generate-docs": "node scripts/generate-token-docs.mjs",
    "tokens:generate-metadata": "node scripts/generate-token-metadata.mjs",
    "tokens:generate-types": "node scripts/generate-token-types.mjs",
    "tokens:generate-vscode": "node scripts/generate-vscode-css-data.mjs",
    "tokens:validate": "node scripts/validate-token-usage.mjs",
    "tokens:validate-architecture": "node scripts/validate-token-architecture.mjs",
    "validate:css-vars": "node scripts/validate-css-vars.mjs",
    "tokens:watch": "nodemon --watch tokens --ext json --exec \"npm run tokens:build:canonical\"",
    "tokens:full": "npm run tokens:build && npm run tokens:generate-metadata && npm run tokens:generate-types && npm run tokens:generate-vscode && npm run tokens:generate-docs && npm run tokens:validate",
    "icons:normalize": "node scripts/normalize-svg-icons.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:process": "npm run icons:normalize && npm run icons:generate",
    "figma:build": "esbuild figma-plugin/code.ts --bundle --format=iife --platform=browser --target=es2017 --outfile=figma-plugin/dist/code.js --loader:.html=text --loader:.json=json",
    "figma:analyze": "node scripts/figma/analyze-snapshot.mjs",
    "figma:migration:generate": "node scripts/figma/generate-migration.mjs",
    "dev:app": "node scripts/dev-app.mjs",
    "build:app": "cd apps/dev-app && npm run build",
    "preview:app": "cd apps/dev-app && npm run preview",
    "storybook:sync-nav": "node scripts/sync-navigation-order.mjs",
    "storybook:sync-config": "node scripts/sync-navigation-config.mjs",
    "storybook:prepare": "npm run tokens:build:canonical && npm run docs:copy && npm run tokens:copy-readme",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:restart": "npm run docs:copy && npm run storybook:dev",
    "storybook": "npm run storybook:prepare && concurrently \"nodemon\" \"npm run docs:watch\" \"npm run tokens:watch\"",
    "storybook:build": "npm run tokens:build && npm run docs:copy && npm run tokens:copy-readme && storybook build",
    "vitest:setup": "playwright install chromium",
    "vitest:storybook": "vitest -c vitest.config.ts --watch",
    "layers:generate": "node scripts/generate-layers.mjs",
    "layers:list": "node scripts/generate-layers.mjs --list",
    "layers:help": "node scripts/generate-layers.mjs --help",
    "generate:html-css": "echo 'HTML/CSS generation not implemented yet'",
    "generate:tsx-clean": "echo 'TSX Clean generation not implemented yet'",
    "generate:tsx": "echo 'TSX generation not implemented yet'",
    "generate:tsx-react-aria": "echo 'TSX React Aria generation not implemented yet'",
    "generate:web-components": "echo 'Web Components generation not implemented yet'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "24.11.1"
  },
  "type": "module",
  "devDependencies": {
    "@figma/code-connect": "^1.3.12",
    "@figma/plugin-typings": "^1.121.0",
    "@handsontable/react-wrapper": "^16.2.0",
    "@storybook/addon-a11y": "^10.1.9",
    "@storybook/addon-docs": "^10.1.9",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.9",
    "@svgr/core": "^8.1.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "autoprefixer": "^10.4.16",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "culori": "^4.0.2",
    "esbuild": "^0.27.1",
    "handsontable": "^16.2.0",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "ignore": "^7.0.5",
    "mermaid": "^11.12.2",
    "msw": "^2.12.4",
    "nodemon": "^3.1.11",
    "playwright": "^1.57.0",
    "postcss": "^8.4.32",
    "prism-react-renderer": "^2.4.1",
    "react-grid-layout": "^2.2.2",
    "storybook": "^10.1.9",
    "style-dictionary": "^5.1.1",
    "svg-path-parser": "^1.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "i18next": "^23.12.0",
    "react": "^19.2.3",
    "react-aria": "^3.45.0",
    "react-device-frame": "^2.1.4",
    "react-dom": "^19.2.3",
    "react-i18next": "^13.5.0",
    "react-markdown": "^10.1.0",
    "react-stately": "^3.43.0",
    "remark-gfm": "^4.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "volta": {
    "node": "24.11.1"
  }
}
