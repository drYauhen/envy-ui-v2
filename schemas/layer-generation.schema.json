{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envy-ui.com/schemas/layer-generation.schema.json",
  "title": "Layer Generation Configuration Schema",
  "description": "Schema for configuring layered component generation in Envy UI v2",
  "type": "object",

  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Configuration version"
    },

    "description": {
      "type": "string",
      "description": "Human-readable description of the configuration"
    },

    "layers": {
      "type": "object",
      "description": "Definition of all available layers",
      "patternProperties": {
        "^[a-z-]+[a-z0-9-]*$": {
          "type": "object",
          "required": ["name", "description", "platforms", "enabled", "dependsOn", "generator"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Display name of the layer"
            },

            "description": {
              "type": "string",
              "description": "Detailed description of what this layer provides"
            },

            "platforms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["css", "js", "tsx", "web-components", "figma", "tokenstudio"]
              },
              "description": "Target platforms for this layer"
            },

            "enabled": {
              "type": "boolean",
              "description": "Whether this layer is enabled for generation"
            },

            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Layers that must be generated before this one"
            },

            "generator": {
              "type": "object",
              "required": ["command", "outputPaths"],
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Command to run for generation"
                },

                "watchCommand": {
                  "type": "string",
                  "description": "Command to run for watch mode"
                },

                "outputPaths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths where generated files are placed"
                }
              }
            },

            "storybook": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "string",
                  "description": "Storybook section name"
                },

                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Display order in Storybook navigation"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },

    "generation": {
      "type": "object",
      "required": ["autoGenerate", "triggerOnTokenChange", "selectedLayers"],
      "properties": {
        "autoGenerate": {
          "type": "boolean",
          "description": "Whether to automatically generate layers on token changes"
        },

        "triggerOnTokenChange": {
          "type": "boolean",
          "description": "Whether to trigger generation when tokens change"
        },

        "selectedLayers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Currently selected layers for generation"
        },

        "parallelExecution": {
          "type": "boolean",
          "description": "Whether to run layer generation in parallel",
          "default": false
        },

        "failFast": {
          "type": "boolean",
          "description": "Whether to stop on first generation error",
          "default": true
        }
      }
    },

    "ai": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether AI assistance is enabled"
        },

        "provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "local"],
          "description": "AI provider to use"
        },

        "model": {
          "type": "string",
          "description": "AI model to use"
        },

        "prompts": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "string",
              "description": "Prompt template for specific transformation"
            }
          },
          "description": "AI prompts for different transformations"
        }
      }
    },

    "validation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether validation is enabled"
        },

        "rules": {
          "type": "object",
          "properties": {
            "token-usage": {
              "type": "boolean",
              "description": "Validate token usage in generated code"
            },

            "accessibility": {
              "type": "boolean",
              "description": "Validate accessibility compliance"
            },

            "performance": {
              "type": "boolean",
              "description": "Validate performance characteristics"
            },

            "consistency": {
              "type": "boolean",
              "description": "Validate consistency across layers"
            }
          }
        }
      }
    }
  },

  "required": ["version", "layers", "generation"],
  "additionalProperties": false
}