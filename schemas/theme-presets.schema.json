{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://envy-ui.com/schemas/theme-presets.schema.json",
  "title": "Theme Presets Schema",
  "description": "Schema for theme preset metadata files (*.presets.meta.json) that define component-specific props for third-party library integration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file"
    },
    "$description": {
      "type": "string",
      "description": "Human-readable description of this preset file"
    },
    "components": {
      "type": "object",
      "description": "Component-specific presets",
      "properties": {
        "handsontable": {
          "type": "object",
          "description": "Handsontable component presets",
          "properties": {
            "props": {
              "type": "object",
              "description": "Props to spread onto HotTable component",
              "additionalProperties": true
            },
            "layout": {
              "type": "object",
              "description": "Layout configuration for the table container",
              "properties": {
                "centerContent": {
                  "type": "boolean",
                  "description": "Whether to center the table content"
                },
                "maxWidth": {
                  "type": "string",
                  "description": "Maximum width (CSS value, e.g., '100%', '1200px')",
                  "pattern": "^([0-9]+(%|px|rem|em|vw)|100%)$"
                }
              },
              "additionalProperties": false
            },
            "styles": {
              "type": "object",
              "description": "Style overrides using token references",
              "additionalProperties": {
                "type": "string",
                "pattern": "^(\\{eui\\.[a-z0-9.-]+\\}|var\\(--[a-z0-9-]+\\)|#[0-9a-fA-F]{3,8}|rgba?\\([^)]+\\)|[a-z]+)$"
              }
            },
            "$meta": {
              "type": "object",
              "description": "Metadata about the preset configuration",
              "properties": {
                "description": {
                  "type": "string",
                  "description": "Description of this preset configuration"
                },
                "vendor": {
                  "type": "string",
                  "description": "Vendor/library name (e.g., 'handsontable')"
                },
                "version": {
                  "type": "string",
                  "description": "Compatible library version (e.g., '^16.2.0')"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["components"],
  "additionalProperties": false
}
