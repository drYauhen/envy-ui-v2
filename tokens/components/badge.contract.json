{
  "$schema": "../../schemas/component-contract.schema.json",
  "component": "badge",
  "version": "v1-draft",
  "status": "draft",
  "source": {
    "legacyCss": "src/ui/badge.css",
    "note": "This contract is derived from legacy CSS to preserve all existing behavior/features during migration."
  },

  "selectors": {
    "scope": "[data-eui-context]",
    "root": ".eui-badge",
    "slots": {}
  },

  "invariants": [
    "Badge is a presentational component: no theme-specific selectors inside canonical component CSS.",
    "Component CSS must not leak into token themes/contexts.",
    "All legacy features must be preserved either in canonical CSS split or in explicit knowledge notes."
  ],

  "axes": {
    "tone": {
      "type": "enum",
      "default": "neutral",
      "values": ["success", "warning", "error", "info", "neutral"],
      "notes": "Badge tone affects background, border, and text colors."
    },
    "variant": {
      "type": "enum",
      "default": "subtle",
      "values": ["subtle", "solid", "outline"],
      "notes": "Subtle (default) has colored background, solid has stronger colors, outline has transparent background with colored border."
    },
    "size": {
      "type": "enum",
      "default": "default",
      "values": ["default", "small"],
      "notes": "Size controls container-driven height, padding, and typography."
    }
  },

  "componentVars": {
    "core": {
      "--eui-badge-border-width": { "type": "dimension" },
      "--eui-badge-border-style": { "type": "string" },
      "--eui-badge-shape-radius": { "type": "dimension" }
    },
    "colors": {
      "--eui-badge-colors-neutral-background": "{eui.color.status.neutral.background}",
      "--eui-badge-colors-neutral-border": "{eui.color.status.neutral.border}",
      "--eui-badge-colors-neutral-text": "{eui.color.status.neutral.text}",
      "--eui-badge-colors-neutral-solid-background": "{eui.color.status.neutral.solid}",
      "--eui-badge-colors-neutral-solid-border": "{eui.color.status.neutral.solid}",
      "--eui-badge-colors-neutral-solid-text": "{eui.color.text.inverse}",
      "--eui-badge-colors-success-background": "{eui.color.status.success.background}",
      "--eui-badge-colors-success-border": "{eui.color.status.success.border}",
      "--eui-badge-colors-success-text": "{eui.color.status.success.text}",
      "--eui-badge-colors-success-solid-background": "{eui.color.status.success.solid}",
      "--eui-badge-colors-success-solid-border": "{eui.color.status.success.solid}",
      "--eui-badge-colors-success-solid-text": "{eui.color.text.inverse}",
      "--eui-badge-colors-warning-background": "{eui.color.status.warning.background}",
      "--eui-badge-colors-warning-border": "{eui.color.status.warning.border}",
      "--eui-badge-colors-warning-text": "{eui.color.status.warning.text}",
      "--eui-badge-colors-warning-solid-background": "{eui.color.status.warning.solid}",
      "--eui-badge-colors-warning-solid-border": "{eui.color.status.warning.solid}",
      "--eui-badge-colors-warning-solid-text": "{eui.color.text.inverse}",
      "--eui-badge-colors-error-background": "{eui.color.status.error.background}",
      "--eui-badge-colors-error-border": "{eui.color.status.error.border}",
      "--eui-badge-colors-error-text": "{eui.color.status.error.text}",
      "--eui-badge-colors-error-solid-background": "{eui.color.status.error.solid}",
      "--eui-badge-colors-error-solid-border": "{eui.color.status.error.solid}",
      "--eui-badge-colors-error-solid-text": "{eui.color.text.inverse}",
      "--eui-badge-colors-info-background": "{eui.color.status.info.background}",
      "--eui-badge-colors-info-border": "{eui.color.status.info.border}",
      "--eui-badge-colors-info-text": "{eui.color.status.info.text}",
      "--eui-badge-colors-info-solid-background": "{eui.color.status.info.solid}",
      "--eui-badge-colors-info-solid-border": "{eui.color.status.info.solid}",
      "--eui-badge-colors-info-solid-text": "{eui.color.text.inverse}",
      "--eui-badge-colors-variant-outline-background": "{eui.color.background.transparent}"
    },
    "size": {
      "--eui-badge-size-default-height": { "type": "dimension" },
      "--eui-badge-size-default-padding-block": { "type": "dimension" },
      "--eui-badge-size-default-padding-inline": { "type": "dimension" },
      "--eui-badge-size-default-gap": { "type": "dimension" },
      "--eui-badge-size-default-fontSize": { "type": "dimension" },
      "--eui-badge-size-default-lineHeight": { "type": "string" },
      "--eui-badge-size-small-height": { "type": "dimension" },
      "--eui-badge-size-small-padding-block": { "type": "dimension" },
      "--eui-badge-size-small-padding-inline": { "type": "dimension" },
      "--eui-badge-size-small-gap": { "type": "dimension" },
      "--eui-badge-size-small-fontSize": { "type": "dimension" },
      "--eui-badge-size-small-lineHeight": { "type": "string" }
    },
    "typography": {
      "--eui-badge-typography-fontFamily": { "type": "string" },
      "--eui-badge-typography-fontWeight": { "type": "string" },
      "--eui-badge-typography-letterSpacing": { "type": "dimension" },
      "--eui-badge-typography-textTransform": { "type": "string" }
    },
    "focus": {
      "--eui-badge-focus-ring-color": { "type": "color" },
      "--eui-badge-focus-ring-width": { "type": "dimension" },
      "--eui-badge-focus-ring-offset": { "type": "dimension" },
      "--eui-badge-focus-color": { "type": "color" }
    },
    "localVars": {
      "--eui-badge-background": { "type": "color" },
      "--eui-badge-color": { "type": "color" },
      "--eui-badge-border": { "type": "color" },
      "--eui-badge-size-height": { "type": "dimension" },
      "--eui-badge-size-padding-block": { "type": "dimension" },
      "--eui-badge-size-padding-inline": { "type": "dimension" },
      "--eui-badge-size-gap": { "type": "dimension" },
      "--eui-badge-size-fontSize": { "type": "dimension" },
      "--eui-badge-size-lineHeight": { "type": "string" }
    }
  },

  "behavior": {
    "layout": {
      "root": {
        "display": "inline-flex",
        "alignItems": "center",
        "height": "var(--eui-badge-size-height)",
        "gap": "var(--eui-badge-size-gap)"
      }
    },
    "visual": {
      "borderRadius": "var(--eui-badge-shape-radius)",
      "borderWidth": "var(--eui-badge-border-width)",
      "borderStyle": "var(--eui-badge-border-style)",
      "backgroundColor": "var(--eui-badge-colors-neutral-background)",
      "color": "var(--eui-badge-colors-neutral-text)",
      "borderColor": "var(--eui-badge-colors-neutral-border)",
      "padding": "var(--eui-badge-size-padding-block) var(--eui-badge-size-padding-inline)"
    },
    "typography": {
      "fontFamily": "var(--eui-badge-typography-fontFamily)",
      "fontSize": "var(--eui-badge-size-fontSize)",
      "fontWeight": "var(--eui-badge-typography-fontWeight)",
      "lineHeight": "var(--eui-badge-size-lineHeight)",
      "letterSpacing": "var(--eui-badge-typography-letterSpacing)",
      "textTransform": "var(--eui-badge-typography-textTransform)",
      "whiteSpace": "nowrap"
    },
    "interactive": {
      "focusRing": {
        "color": "var(--eui-badge-focus-color)",
        "width": "var(--eui-badge-focus-ring-width)",
        "offset": "var(--eui-badge-focus-ring-offset)"
      },
      "transitions": "filter 120ms ease, transform 120ms ease, box-shadow 120ms ease",
      "hover": "brightness(0.96)",
      "active": "translateY(1px)",
      "disabled": "opacity: 0.6"
    }
  },

  "nonCanonicalThemeNotes": [
    {
      "context": "app",
      "theme": "accessibility",
      "legacyBehavior": [
        "High-contrast colors for WCAG 2.2 AA compliance",
        "Focus ring uses accent-700 instead of accent-300",
        "Neutral badge uses #ffffff background with #000000 text"
      ],
      "policy": "Preserve as knowledge note only. Do not include theme-specific selectors in canonical component CSS."
    }
  ]
}
