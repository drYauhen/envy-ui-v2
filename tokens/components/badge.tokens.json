{
  "$schema": "../../schemas/dtcg-2025.10-schema.json",
  "eui": {
    "badge": {
      "size": {
        "default": {
          "height": {
            "$value": "{eui.dimension.5}",
            "$type": "dimension",
            "$description": "Default badge height (container-driven, 20px)"
          },
          "padding": {
            "block": {
              "$value": "{eui.dimension.0}",
              "$type": "dimension",
              "$description": "Default badge vertical padding (container-driven)"
            },
            "inline": {
              "$value": "{eui.spacing.sm}",
              "$type": "dimension",
              "$description": "Default badge horizontal padding"
            }
          },
          "gap": {
            "$value": "{eui.spacing.xs}",
            "$type": "dimension",
            "$description": "Default badge gap between elements"
          },
          "fontSize": {
            "$value": "{eui.typography.fontSize.xs}",
            "$type": "dimension",
            "$description": "Default badge font size"
          },
          "lineHeight": {
            "$value": "{eui.typography.lineHeight.tight}",
            "$type": "string",
            "$description": "Default badge line height"
          }
        },
        "small": {
          "height": {
            "$value": "{eui.dimension.4}",
            "$type": "dimension",
            "$description": "Small badge height (compact, container-driven, 16px)"
          },
          "padding": {
            "block": {
              "$value": "{eui.dimension.0}",
              "$type": "dimension",
              "$description": "Small badge vertical padding (container-driven)"
            },
            "inline": {
              "$value": "{eui.spacing.xs}",
              "$type": "dimension",
              "$description": "Small badge horizontal padding"
            }
          },
          "gap": {
            "$value": "{eui.spacing.2xs}",
            "$type": "dimension",
            "$description": "Small badge gap between elements"
          },
          "fontSize": {
            "$value": "{eui.typography.fontSize.xs}",
            "$type": "dimension",
            "$description": "Small badge font size"
          },
          "lineHeight": {
            "$value": "{eui.typography.lineHeight.tight}",
            "$type": "string",
            "$description": "Small badge line height"
          }
        }
      },
      "shape": {
        "pill": {
          "radius": {
            "$value": "calc(var(--eui-badge-size-height) / 2)",
            "$type": "dimension",
            "$description": "Pill badge radius derived from container height"
          }
        },
        "circle": {
          "radius": {
            "$value": "calc(var(--eui-badge-size-height) / 2)",
            "$type": "dimension",
            "$description": "Circle badge radius for fully rounded shape"
          }
        }
      },
      "variant": {
        "subtle": {
          "tone": {
            "neutral": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.neutral.background}",
                  "$type": "color",
                  "$description": "Neutral subtle badge background"
                },
                "border": {
                  "$value": "{eui.color.status.neutral.border}",
                  "$type": "color",
                  "$description": "Neutral subtle badge border"
                },
                "text": {
                  "$value": "{eui.color.status.neutral.text}",
                  "$type": "color",
                  "$description": "Neutral subtle badge text"
                }
              }
            },
            "success": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.success.background}",
                  "$type": "color",
                  "$description": "Success subtle badge background"
                },
                "border": {
                  "$value": "{eui.color.status.success.border}",
                  "$type": "color",
                  "$description": "Success subtle badge border"
                },
                "text": {
                  "$value": "{eui.color.status.success.text}",
                  "$type": "color",
                  "$description": "Success subtle badge text"
                }
              }
            },
            "warning": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.warning.background}",
                  "$type": "color",
                  "$description": "Warning subtle badge background"
                },
                "border": {
                  "$value": "{eui.color.status.warning.border}",
                  "$type": "color",
                  "$description": "Warning subtle badge border"
                },
                "text": {
                  "$value": "{eui.color.status.warning.text}",
                  "$type": "color",
                  "$description": "Warning subtle badge text"
                }
              }
            },
            "error": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.error.background}",
                  "$type": "color",
                  "$description": "Error subtle badge background"
                },
                "border": {
                  "$value": "{eui.color.status.error.border}",
                  "$type": "color",
                  "$description": "Error subtle badge border"
                },
                "text": {
                  "$value": "{eui.color.status.error.text}",
                  "$type": "color",
                  "$description": "Error subtle badge text"
                }
              }
            },
            "info": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.info.background}",
                  "$type": "color",
                  "$description": "Info subtle badge background"
                },
                "border": {
                  "$value": "{eui.color.status.info.border}",
                  "$type": "color",
                  "$description": "Info subtle badge border"
                },
                "text": {
                  "$value": "{eui.color.status.info.text}",
                  "$type": "color",
                  "$description": "Info subtle badge text"
                }
              }
            }
          }
        },
        "solid": {
          "tone": {
            "neutral": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.neutral.solid}",
                  "$type": "color",
                  "$description": "Neutral solid badge background"
                },
                "border": {
                  "$value": "{eui.color.status.neutral.solid}",
                  "$type": "color",
                  "$description": "Neutral solid badge border"
                },
                "text": {
                  "$value": "{eui.color.text.inverse}",
                  "$type": "color",
                  "$description": "Neutral solid badge text"
                }
              }
            },
            "success": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.success.solid}",
                  "$type": "color",
                  "$description": "Success solid badge background"
                },
                "border": {
                  "$value": "{eui.color.status.success.solid}",
                  "$type": "color",
                  "$description": "Success solid badge border"
                },
                "text": {
                  "$value": "{eui.color.text.inverse}",
                  "$type": "color",
                  "$description": "Success solid badge text"
                }
              }
            },
            "warning": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.warning.solid}",
                  "$type": "color",
                  "$description": "Warning solid badge background"
                },
                "border": {
                  "$value": "{eui.color.status.warning.solid}",
                  "$type": "color",
                  "$description": "Warning solid badge border"
                },
                "text": {
                  "$value": "{eui.color.text.inverse}",
                  "$type": "color",
                  "$description": "Warning solid badge text"
                }
              }
            },
            "error": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.error.solid}",
                  "$type": "color",
                  "$description": "Error solid badge background"
                },
                "border": {
                  "$value": "{eui.color.status.error.solid}",
                  "$type": "color",
                  "$description": "Error solid badge border"
                },
                "text": {
                  "$value": "{eui.color.text.inverse}",
                  "$type": "color",
                  "$description": "Error solid badge text"
                }
              }
            },
            "info": {
              "colors": {
                "background": {
                  "$value": "{eui.color.status.info.solid}",
                  "$type": "color",
                  "$description": "Info solid badge background"
                },
                "border": {
                  "$value": "{eui.color.status.info.solid}",
                  "$type": "color",
                  "$description": "Info solid badge border"
                },
                "text": {
                  "$value": "{eui.color.text.inverse}",
                  "$type": "color",
                  "$description": "Info solid badge text"
                }
              }
            }
          }
        },
        "outline": {
          "colors": {
            "background": {
              "$value": "{eui.color.background.transparent}",
              "$type": "color",
              "$description": "Outline badge transparent background"
            }
          }
        }
      },
      "base": {
        "dismiss": {
          "size": {
            "default": {
              "padding": {
                "block": {
                  "$value": "{eui.dimension.0}",
                  "$type": "dimension",
                  "$description": "Dismiss action vertical padding for default badge size"
                },
                "inline": {
                  "$value": "calc((var(--eui-spacing-xs) + var(--eui-spacing-sm)) / 2)",
                  "$type": "dimension",
                  "$description": "Dismiss action horizontal padding for default badge size"
                }
              },
              "icon": {
                "size": {
                  "$value": "{eui.typography.fontSize.xs}",
                  "$type": "dimension",
                  "$description": "Dismiss icon size for default badge size"
                }
              }
            },
            "small": {
              "padding": {
                "block": {
                  "$value": "{eui.dimension.0}",
                  "$type": "dimension",
                  "$description": "Dismiss action vertical padding for small badge size"
                },
                "inline": {
                  "$value": "{eui.spacing.xs}",
                  "$type": "dimension",
                  "$description": "Dismiss action horizontal padding for small badge size"
                }
              },
              "icon": {
                "size": {
                  "$value": "{eui.typography.fontSize.xs}",
                  "$type": "dimension",
                  "$description": "Dismiss icon size for small badge size"
                }
              }
            }
          },
          "divider": {
            "width": {
              "$value": "{eui.border.width.thin}",
              "$type": "dimension",
              "$description": "Divider width between badge content and dismiss action"
            }
          },
          "icon": {
            "opacity": {
              "$value": "{eui.opacity.subtle}",
              "$type": "number",
              "$description": "Dismiss icon opacity in default state"
            },
            "opacityHover": {
              "$value": 1,
              "$type": "number",
              "$description": "Dismiss icon opacity on hover"
            }
          },
          "state": {
            "hover": {
              "filter": {
                "$value": "brightness(0.96)",
                "$type": "string",
                "$description": "Dismiss action hover filter"
              }
            },
            "active": {
              "filter": {
                "$value": "brightness(0.92)",
                "$type": "string",
                "$description": "Dismiss action active filter"
              }
            }
          }
        },
        "border": {
          "width": {
            "$value": "{eui.border.width.thin}",
            "$type": "dimension",
            "$description": "Badge border width"
          },
          "style": {
            "$value": "{eui.border.style.default}",
            "$type": "string",
            "$description": "Badge border style"
          }
        },
        "shape": {
          "radius": {
            "$value": "{eui.inline.radius}",
            "$type": "dimension",
            "$description": "Badge border radius (shared inline radius)."
          }
        },
        "typography": {
          "fontFamily": {
            "$value": "{eui.typography.fontFamily.ui}",
            "$type": "string",
            "$description": "Badge font family"
          },
          "fontWeight": {
            "$value": "{eui.typography.fontWeight.medium}",
            "$type": "string",
            "$description": "Badge font weight"
          },
          "letterSpacing": {
            "$value": "{eui.typography.letterSpacing.wide}",
            "$type": "dimension",
            "$description": "Badge letter spacing"
          },
          "textTransform": {
            "$value": "{eui.typography.textTransform.uppercase}",
            "$type": "string",
            "$description": "Badge text transform"
          }
        },
        "focus": {
          "ring": {
            "color": {
              "$value": "{eui.color.focus.ring}",
              "$type": "color",
              "$description": "Badge focus ring color (theme-driven)"
            },
            "width": {
              "$value": "{eui.focus.ring.width}",
              "$type": "dimension",
              "$description": "Badge focus ring width (2px)"
            },
            "offset": {
              "$value": "{eui.focus.ring.offset.default}",
              "$type": "dimension",
              "$description": "Badge focus ring offset"
            }
          },
          "color": {
            "$value": "{eui.color.focus.ring}",
            "$type": "color",
            "$description": "Badge focus color"
          }
        }
      }
    }
  }
}
