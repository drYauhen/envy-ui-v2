{
  "$schema": "../../schemas/dtcg-2025.10-schema.json",
  "eui": {
    "calendar": {
      "variant": {
        "surface": {
          "default": {
            "background": {
              "$value": "{eui.color.background.surface}",
              "$type": "color",
              "$description": "Calendar default surface background"
            },
            "border": {
              "$value": "{eui.color.border.default}",
              "$type": "color",
              "$description": "Calendar default surface border"
            }
          },
          "embedded": {
            "background": {
              "$value": "transparent",
              "$type": "color",
              "$description": "Calendar embedded surface background"
            },
            "border": {
              "$value": "transparent",
              "$type": "color",
              "$description": "Calendar embedded surface border"
            }
          }
        },
        "state": {
          "default": {
            "day": {
              "background": {
                "$value": "{eui.color.background.surface}",
                "$type": "color",
                "$description": "Calendar day default background"
              },
              "border": {
                "$value": "transparent",
                "$type": "color",
                "$description": "Calendar day default border (transparent for clean look)"
              },
              "text": {
                "$value": "{eui.color.text.primary}",
                "$type": "color",
                "$description": "Calendar day default text"
              }
            },
            "header": {
              "background": {
                "$value": "{eui.color.background.surface}",
                "$type": "color",
                "$description": "Calendar header default background"
              },
              "text": {
                "$value": "{eui.color.text.primary}",
                "$type": "color",
                "$description": "Calendar header default text"
              }
            },
            "weekday": {
              "text": {
                "$value": "{eui.color.text.muted}",
                "$type": "color",
                "$description": "Calendar weekday default text"
              }
            }
          },
          "hover": {
            "day": {
              "background": {
                "$value": "{eui.color.background.muted}",
                "$type": "color",
                "$description": "Calendar day hover background"
              }
            }
          },
          "active": {
            "day": {
              "background": {
                "$value": "{eui.color.background.subtle}",
                "$type": "color",
                "$description": "Calendar day active background"
              }
            }
          },
          "selected": {
            "day": {
              "background": {
                "$value": "{eui.color.accent.primary}",
                "$type": "color",
                "$description": "Calendar selected day background"
              },
              "border": {
                "$value": "{eui.color.accent.primary}",
                "$type": "color",
                "$description": "Calendar selected day border"
              },
              "text": {
                "$value": "{eui.color.text.inverse}",
                "$type": "color",
                "$description": "Calendar selected day text"
              }
            }
          },
          "today": {
            "day": {
              "fontWeight": {
                "$value": "600",
                "$type": "fontWeight",
                "$description": "Calendar today font weight (component-specific)"
              }
            }
          },
          "disabled": {
            "day": {
              "background": {
                "$value": "{eui.color.background.surface}",
                "$type": "color",
                "$description": "Calendar disabled day background"
              },
              "text": {
                "$value": "{eui.color.text.disabled}",
                "$type": "color",
                "$description": "Calendar disabled day text"
              },
              "opacity": {
                "$value": "{eui.opacity.disabled}",
                "$type": "number",
                "$description": "Calendar disabled day opacity"
              }
            }
          },
          "outsideMonth": {
            "day": {
              "background": {
                "$value": "{eui.color.background.surface}",
                "$type": "color",
                "$description": "Calendar outside month day background"
              },
              "text": {
                "$value": "{eui.color.text.subtle}",
                "$type": "color",
                "$description": "Calendar outside month day text"
              },
              "opacity": {
                "$value": "0.6",
                "$type": "number",
                "$description": "Calendar outside month day opacity (component-specific)"
              }
            }
          },
          "range": {
            "day": {
              "background": {
                "$value": "{eui-app-raw-color-accent-50}",
                "$type": "color",
                "$description": "Calendar range day background (legacy accent.50)"
              },
              "text": {
                "$value": "{eui.color.text.primary}",
                "$type": "color",
                "$description": "Calendar range day text"
              }
            }
          },
          "rangeHover": {
            "day": {
              "background": {
                "$value": "{eui-app-raw-color-accent-100}",
                "$type": "color",
                "$description": "Calendar range day hover background (legacy accent.100)"
              }
            }
          }
        }
      },
      "base": {
        "size": {
          "container": {
            "width": {
              "$value": "fit-content",
              "$type": "dimension",
              "$description": "Calendar container width (shrink-wraps to content size)"
            },
            "minWidth": {
              "$value": "fit-content",
              "$type": "dimension",
              "$description": "Calendar container minimum width (shrink-wraps to content size)"
            }
          },
          "day": {
            "width": {
              "$value": "{eui.dimension.8}",
              "$type": "dimension",
              "$description": "Calendar day cell width"
            },
            "minHeight": {
              "$value": "{eui.dimension.8}",
              "$type": "dimension",
              "$description": "Calendar day cell minimum height"
            },
            "aspectRatio": {
              "$value": "1",
              "$type": "number",
              "$description": "Calendar day cell aspect ratio (component-specific)"
            }
          },
          "weekday": {
            "width": {
              "$value": "{eui.dimension.8}",
              "$type": "dimension",
              "$description": "Calendar weekday label width"
            },
            "height": {
              "$value": "{eui.dimension.8}",
              "$type": "dimension",
              "$description": "Calendar weekday label height"
            }
          }
        },
        "spacing": {
          "container": {
            "padding": {
              "$value": "{eui.spacing.md}",
              "$type": "dimension",
              "$description": "Calendar container padding"
            }
          },
          "header": {
            "padding": {
              "vertical": {
                "$value": "{eui.spacing.xs}",
                "$type": "dimension",
                "$description": "Calendar header vertical padding"
              },
              "horizontal": {
                "$value": "{eui.spacing.md}",
                "$type": "dimension",
                "$description": "Calendar header horizontal padding"
              }
            }
          },
          "weekday": {
            "padding": {
              "vertical": {
                "$value": "{eui.spacing.2xs}",
                "$type": "dimension",
                "$description": "Calendar weekday vertical padding"
              }
            }
          },
          "day": {
            "padding": {
              "vertical": {
                "$value": "{eui.spacing.2xs}",
                "$type": "dimension",
                "$description": "Calendar day vertical padding"
              },
              "horizontal": {
                "$value": "{eui.spacing.2xs}",
                "$type": "dimension",
                "$description": "Calendar day horizontal padding"
              }
            },
            "margin": {
              "overlap": {
                "$value": "0px",
                "$type": "dimension",
                "$description": "Calendar day margin overlap (set to 0 with transparent borders)"
              }
            }
          }
        },
        "typography": {
          "header": {
            "fontSize": {
              "$value": "{eui.typography.fontSize.lg}",
              "$type": "fontSize",
              "$description": "Calendar header font size"
            },
            "fontWeight": {
              "$value": "600",
              "$type": "fontWeight",
              "$description": "Calendar header font weight (component-specific)"
            }
          },
          "weekday": {
            "fontSize": {
              "$value": "{eui.typography.fontSize.sm}",
              "$type": "fontSize",
              "$description": "Calendar weekday font size"
            },
            "fontWeight": {
              "$value": "500",
              "$type": "fontWeight",
              "$description": "Calendar weekday font weight (component-specific)"
            }
          },
          "day": {
            "fontSize": {
              "$value": "{eui.typography.fontSize.sm}",
              "$type": "fontSize",
              "$description": "Calendar day font size"
            },
            "fontWeight": {
              "$value": "400",
              "$type": "fontWeight",
              "$description": "Calendar day font weight (component-specific)"
            },
            "lineHeight": {
              "$value": "1",
              "$type": "lineHeight",
              "$description": "Calendar day line height (component-specific)"
            }
          }
        },
        "border": {
          "width": {
            "$value": "{eui.border.width.thin}",
            "$type": "dimension",
            "$description": "Calendar border width"
          }
        },
        "shape": {
          "radius": {
            "$value": "{eui.radius.default}",
            "$type": "dimension",
            "$description": "Calendar border radius"
          }
        },
        "focus": {
          "ring": {
            "color": {
              "$value": "{eui.color.focus.ring}",
              "$type": "color",
              "$description": "Calendar focus ring color (theme-driven)"
            },
            "width": {
              "$value": "{eui.focus.ring.width}",
              "$type": "dimension",
              "$description": "Calendar focus ring width (2px)"
            },
            "offset": {
              "$value": "{eui.focus.ring.offset.default}",
              "$type": "dimension",
              "$description": "Calendar focus ring offset"
            }
          }
        },
        "zIndex": {
          "default": {
            "$value": "0",
            "$type": "number",
            "$description": "Calendar default z-index"
          },
          "interactive": {
            "$value": "1",
            "$type": "number",
            "$description": "Calendar interactive state z-index"
          },
          "selected": {
            "$value": "2",
            "$type": "number",
            "$description": "Calendar selected state z-index"
          },
          "focus": {
            "$value": "3",
            "$type": "number",
            "$description": "Calendar focus state z-index"
          }
        },
        "transition": {
          "duration": {
            "$value": "{eui.transition.duration.fast}",
            "$type": "duration",
            "$description": "Calendar transition duration"
          },
          "easing": {
            "$value": "{eui.transition.easing.default}",
            "$type": "string",
            "$description": "Calendar transition easing"
          }
        }
      }
    }
  }
}
