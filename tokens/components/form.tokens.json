{
  "$schema": "../../schemas/dtcg-2025.10-schema.json",
  "eui": {
    "form": {
      "spacing": {
        "field": {
          "gap": {
            "internal": {
              "$value": "{eui.spacing.sm}",
              "$type": "dimension",
              "$description": "Gap between label, control, and messages within a field."
            },
            "external": {
              "$value": "{eui.spacing.md}",
              "$type": "dimension",
              "$description": "Vertical rhythm between fields."
            }
          }
        },
        "section": {
          "gap": {
            "internal": {
              "$value": "{eui.spacing.md}",
              "$type": "dimension",
              "$description": "Gap between fields inside a section."
            },
            "external": {
              "$value": "{eui.spacing.lg}",
              "$type": "dimension",
              "$description": "Vertical rhythm between sections."
            },
            "title": {
              "$value": "{eui.spacing.md}",
              "$type": "dimension",
              "$description": "Spacing between section header and content."
            }
          },
          "header": {
            "padding": {
              "$value": "{eui.spacing.sm}",
              "$type": "dimension",
              "$description": "Padding inside section headers."
            }
          }
        },
        "group": {
          "gap": {
            "$value": "{eui.spacing.sm}",
            "$type": "dimension",
            "$description": "Gap between items in a grouped control."
          }
        },
        "row": {
          "gap": {
            "$value": "{eui.spacing.md}",
            "$type": "dimension",
            "$description": "Gap between columns in a row."
          }
        },
        "actions": {
          "gap": {
            "$value": "{eui.spacing.sm}",
            "$type": "dimension",
            "$description": "Gap between actions (buttons/links)."
          },
          "padding": {
            "top": {
              "$value": "{eui.spacing.lg}",
              "$type": "dimension",
              "$description": "Spacing above form actions."
            }
          }
        }
      },
      "layout": {
        "label": {
          "width": {
            "$value": "120px",
            "$type": "dimension",
            "$description": "Label column width for horizontal forms."
          },
          "gap": {
            "$value": "{eui.spacing.md}",
            "$type": "dimension",
            "$description": "Gap between label column and control column."
          }
        },
        "control": {
          "maxWidth": {
            "$value": "360px",
            "$type": "dimension",
            "$description": "Default max width for controls."
          }
        },
        "breakpoint": {
          "stacked": {
            "$value": "480px",
            "$type": "dimension",
            "$description": "Container width that switches auto layout to stacked."
          }
        }
      },
      "field": {
        "input": {
          "padding": {
            "top": {
              "$value": "{eui.spacing.sm}",
              "$type": "dimension",
              "$description": "Top padding to align label with control in horizontal layouts."
            }
          }
        }
      },
      "animation": {
        "duration": {
          "$value": "{eui.transition.duration.base}",
          "$type": "duration",
          "$description": "Section expand/collapse duration."
        },
        "easing": {
          "$value": "{eui.transition.easing.inOut}",
          "$type": "cubicBezier",
          "$description": "Section expand/collapse easing."
        }
      },
      "density": {
        "compact": {
          "spacing": {
            "field": {
              "gap": {
                "internal": {
                  "$value": "{eui.spacing.xs}",
                  "$type": "dimension",
                  "$description": "Compact internal field spacing."
                },
                "external": {
                  "$value": "{eui.spacing.sm}",
                  "$type": "dimension",
                  "$description": "Compact vertical rhythm between fields."
                }
              }
            },
            "section": {
              "gap": {
                "internal": {
                  "$value": "{eui.spacing.sm}",
                  "$type": "dimension",
                  "$description": "Compact spacing between fields inside a section."
                },
                "external": {
                  "$value": "{eui.spacing.md}",
                  "$type": "dimension",
                  "$description": "Compact spacing between sections."
                },
                "title": {
                  "$value": "{eui.spacing.sm}",
                  "$type": "dimension",
                  "$description": "Compact spacing between section header and content."
                }
              },
              "header": {
                "padding": {
                  "$value": "{eui.spacing.xs}",
                  "$type": "dimension",
                  "$description": "Compact section header padding."
                }
              }
            },
            "group": {
              "gap": {
                "$value": "{eui.spacing.xs}",
                "$type": "dimension",
                "$description": "Compact gap between grouped controls."
              }
            },
            "row": {
              "gap": {
                "$value": "{eui.spacing.sm}",
                "$type": "dimension",
                "$description": "Compact gap between columns in a row."
              }
            },
            "actions": {
              "gap": {
                "$value": "{eui.spacing.xs}",
                "$type": "dimension",
                "$description": "Compact gap between actions."
              },
              "padding": {
                "top": {
                  "$value": "{eui.spacing.md}",
                  "$type": "dimension",
                  "$description": "Compact spacing above actions."
                }
              }
            }
          },
          "layout": {
            "label": {
              "gap": {
                "$value": "{eui.spacing.sm}",
                "$type": "dimension",
                "$description": "Compact gap between label and control columns."
              }
            }
          },
          "field": {
            "input": {
              "padding": {
                "top": {
                  "$value": "{eui.spacing.xs}",
                  "$type": "dimension",
                  "$description": "Compact label alignment padding."
                }
              }
            }
          }
        }
      }
    }
  }
}
