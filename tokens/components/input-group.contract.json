{
  "$schema": "../../schemas/component-contract.schema.json",
  "component": "input-group",
  "version": "v1-draft",
  "status": "draft",
  "source": {
    "legacyCss": "src/ui/input-group.css",
    "note": "Derived from legacy input-group styles to preserve prefix/suffix behavior."
  },

  "selectors": {
    "scope": "[data-eui-context]",
    "root": ".eui-input-group",
    "slots": {
      "prefix": ".eui-input-prefix",
      "suffix": ".eui-input-suffix",
      "input": ".eui-input"
    }
  },

  "axes": {
    "size": {
      "type": "enum",
      "default": "md",
      "values": ["sm", "md", "lg"],
      "attribute": "data-eui-size",
      "notes": "Controls slot sizing for prefix/suffix and input alignment."
    },
    "state": {
      "type": "enum",
      "default": "default",
      "values": ["default", "error"],
      "attribute": "data-eui-state",
      "notes": "Error uses error border color on group container."
    }
  },

  "componentVars": {
    "spacing": {
      "--eui-input-group-spacing-prefix-padding-left": { "type": "dimension" },
      "--eui-input-group-spacing-prefix-padding-right": { "type": "dimension" },
      "--eui-input-group-spacing-suffix-padding-left": { "type": "dimension" },
      "--eui-input-group-spacing-suffix-padding-right": { "type": "dimension" },
      "--eui-input-group-spacing-input-padding-left": { "type": "dimension" },
      "--eui-input-group-spacing-input-padding-right": { "type": "dimension" }
    },
    "size": {
      "--eui-input-group-size-prefix-width-sm": { "type": "dimension" },
      "--eui-input-group-size-prefix-width-md": { "type": "dimension" },
      "--eui-input-group-size-prefix-width-lg": { "type": "dimension" },
      "--eui-input-group-size-prefix-height-sm": { "type": "dimension" },
      "--eui-input-group-size-prefix-height-md": { "type": "dimension" },
      "--eui-input-group-size-prefix-height-lg": { "type": "dimension" },
      "--eui-input-group-size-suffix-width-sm": { "type": "dimension" },
      "--eui-input-group-size-suffix-width-md": { "type": "dimension" },
      "--eui-input-group-size-suffix-width-lg": { "type": "dimension" },
      "--eui-input-group-size-suffix-height-sm": { "type": "dimension" },
      "--eui-input-group-size-suffix-height-md": { "type": "dimension" },
      "--eui-input-group-size-suffix-height-lg": { "type": "dimension" }
    },
    "colors": {
      "--eui-input-group-colors-prefix-text": { "type": "color" },
      "--eui-input-group-colors-suffix-text": { "type": "color" }
    }
  }
}
