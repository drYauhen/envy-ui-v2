{
  "$schema": "../../schemas/dtcg-2025.10-schema.json",
  "eui": {
    "link": {
      "base": {
        "colors": {
          "text": {
            "$value": "{eui.color.brand.base}",
            "$type": "color",
            "$description": "Default inline link color (brand base)."
          }
        },
        "shape": {
          "radius": {
            "$value": "{eui.inline.radius}",
            "$type": "dimension",
            "$description": "Link focus ring radius."
          }
        },
        "typography": {
          "textDecoration": {
            "$value": "{eui.typography.textDecoration.underline}",
            "$type": "textDecoration",
            "$description": "Inline link underline style."
          }
        },
        "layout": {
          "externalIndicator": {
            "size": {
              "$value": "0.9em",
              "$type": "dimension",
              "$description": "External-link indicator size for new-tab links."
            },
            "gap": {
              "$value": "0.2143em",
              "$type": "dimension",
              "$description": "Gap between link text and external-link indicator."
            },
            "offsetY": {
              "$value": "0.0714em",
              "$type": "dimension",
              "$description": "Vertical offset for optical alignment of external-link indicator."
            }
          }
        },
        "focus": {
          "ring": {
            "color": {
              "$value": "{eui.color.focus.ring}",
              "$type": "color",
              "$description": "Link focus ring color."
            },
            "width": {
              "$value": "{eui.focus.ring.width}",
              "$type": "dimension",
              "$description": "Link focus ring width."
            },
            "offset": {
              "$value": "{eui.focus.ring.offset.default}",
              "$type": "dimension",
              "$description": "Link focus ring offset."
            }
          }
        }
      },
      "state": {
        "visited": {
          "colors": {
            "text": {
              "$value": "{eui.color.brand.base}",
              "$type": "color",
              "$description": "Visited inline link color (brand base)."
            }
          }
        },
        "hover": {
          "colors": {
            "text": {
              "$value": "{eui.color.brand.base}",
              "$type": "color",
              "$description": "Hover inline link color (brand base)."
            }
          }
        }
      }
    }
  }
}
