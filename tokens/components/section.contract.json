{
  "$schema": "../../schemas/component-contract.schema.json",
  "component": "section",
  "version": "v1-draft",
  "status": "draft",
  "source": {
    "legacyCss": "src/ui/section.css",
    "note": "Canonical layout section derived from existing styles."
  },

  "selectors": {
    "scope": "[data-eui-context]",
    "root": ".eui-section",
    "slots": {
      "title": ".eui-section__title",
      "content": ".eui-section__content"
    }
  },

  "componentVars": {
    "spacing": {
      "--eui-section-gap": { "type": "dimension" },
      "--eui-section-padding": { "type": "dimension" },
      "--eui-section-title-gap": { "type": "dimension" }
    }
  }
}
