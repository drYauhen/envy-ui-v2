{
  "$schema": "../../schemas/dtcg-2025.10-schema.json",
  "eui": {
    "skeleton": {
      "base": {
        "colors": {
          "background": {
            "base": {
              "$value": "{eui.color.neutral.200}",
              "$type": "color",
              "$description": "Base background color for skeleton."
            }
          },
          "shimmer": {
            "start": {
              "$value": "rgba(0, 0, 0, 0)",
              "$type": "color",
              "$description": "Shimmer gradient start color (transparent)."
            },
            "mid": {
              "$value": "rgba(255, 255, 255, 0.4)",
              "$type": "color",
              "$description": "Shimmer gradient middle color (semi-opaque white)."
            },
            "end": {
              "$value": "rgba(0, 0, 0, 0)",
              "$type": "color",
              "$description": "Shimmer gradient end color (transparent)."
            }
          }
        },
        "animation": {
          "duration": {
            "$value": "1.5s",
            "$type": "duration",
            "$description": "Shimmer animation duration."
          },
          "easing": {
            "$value": "linear",
            "$type": "string",
            "$description": "Animation easing function for shimmer."
          },
          "shimmer": {
            "width": {
              "$value": "200%",
              "$type": "dimension",
              "$description": "Width of shimmer gradient."
            }
          },
          "stagger": {
            "step": {
              "$value": "100ms",
              "$type": "duration",
              "$description": "Delay step between consecutive skeletons in wave animation."
            },
            "max": {
              "$value": "800ms",
              "$type": "duration",
              "$description": "Maximum stagger delay for wave animation."
            }
          }
        }
      },
      "size": {
        "text": {
          "lineHeight": {
            "$value": "1.25rem",
            "$type": "dimension",
            "$description": "Height for text skeleton lines."
          }
        },
        "rectangular": {
          "defaultHeight": {
            "$value": "1rem",
            "$type": "dimension",
            "$description": "Default height for rectangular skeleton variant."
          }
        },
        "circular": {
          "defaultDiameter": {
            "$value": "40px",
            "$type": "dimension",
            "$description": "Default diameter for circular skeleton variant."
          }
        }
      },
      "shape": {
        "text": {
          "radius": {
            "$value": "0px",
            "$type": "dimension",
            "$description": "Border radius for text skeleton variant."
          }
        },
        "rectangular": {
          "radius": {
            "$value": "{eui.radius.default}",
            "$type": "dimension",
            "$description": "Border radius for rectangular skeleton variant."
          }
        },
        "circular": {
          "radius": {
            "$value": "50%",
            "$type": "dimension",
            "$description": "Border radius for circular skeleton variant."
          }
        }
      }
    }
  }
}
