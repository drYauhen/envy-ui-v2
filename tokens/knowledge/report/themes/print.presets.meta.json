{
  "$schema": "../../../schemas/theme-presets.schema.json",
  "$description": "Component presets for report context print theme",
  "components": {
    "handsontable": {
      "props": {
        "theme": "ht-theme-main",
        "stretchH": "all",
        "className": "ht-theme-main report-print"
      },
      "layout": {
        "centerContent": false,
        "maxWidth": "100%"
      },
      "styles": {
        "headerBackground": "{eui.color.surface.secondary}",
        "headerTextColor": "{eui.color.text.primary}",
        "rowBackground": "{eui.color.surface.base}",
        "borderColor": "{eui.color.border.subtle}"
      },
      "$meta": {
        "description": "Print-optimized Handsontable configuration for reports",
        "vendor": "handsontable",
        "version": "^16.2.0"
      }
    }
  }
}
