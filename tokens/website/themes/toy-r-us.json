          "text": {
            "$value": "#E1007A",
            "$type": "color",
            "$description": "Bright header text to match Toy-R-Us accent."
          }
        },
        "subheader": {
          "background": {
            "$value": "rgba(255, 255, 255, 0.7)",
            "$type": "color",
            "$description": "Subheader tint for layered headers."
