            "$description": "Playful header font stack for Toy-R-Us theme."
          },
          "fontSize": {
            "$value": "1.15rem",
            "$type": "fontSize",
            "$description": "Larger header size for playful emphasis."
          },
          "fontWeight": {
            "$value": "400",
            "$type": "fontWeight",
            "$description": "Lilita One regular weight."
          }
        }
      },
      "variant": {
