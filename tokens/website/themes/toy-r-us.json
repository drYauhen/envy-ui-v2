            "$value": "no-repeat",
            "$type": "string"
          },
          "backgroundPosition": {
            "$value": "center",
            "$type": "string"
          },
          "backgroundSize": {
            "$value": "cover",
            "$type": "string"
          },
          "radius": {
            "$value": "18px",
            "$type": "dimension",
            "$description": "Slightly larger radius for strong cards."
