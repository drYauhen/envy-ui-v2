            "$description": "Soft playful gradient for flat cards."
          },
          "backgroundRepeat": {
            "$value": "no-repeat",
            "$type": "string"
          },
          "backgroundPosition": {
            "$value": "center",
            "$type": "string"
          },
          "backgroundSize": {
            "$value": "cover",
            "$type": "string"
          },
          "radius": {
            "$value": "16px",
            "$type": "dimension",
            "$description": "Extra-rounded corners for playful cards."
          }
        },
