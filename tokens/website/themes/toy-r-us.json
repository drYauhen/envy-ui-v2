              "$type": "color",
              "$description": "Transparent rows to reveal card background."
            },
            "hover": {
              "$value": "rgba(255, 255, 255, 0.5)",
              "$type": "color",
              "$description": "Soft hover tint for rows."
            },
            "selected": {
              "$value": "rgba(255, 225, 214, 0.65)",
              "$type": "color",
              "$description": "Warm selection tint for rows."
