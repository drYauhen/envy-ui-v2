        "border": {
          "$value": "rgba(225, 0, 122, 0.35)",
          "$type": "color",
          "$description": "Soft pink table borders for Toy-R-Us theme."
        },
        "header": {
          "background": {
            "$value": "rgba(255, 255, 255, 0.8)",
            "$type": "color",
            "$description": "Light header tint for readability over gradients."
