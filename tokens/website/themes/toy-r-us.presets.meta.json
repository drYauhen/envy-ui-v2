{
  "$schema": "../../../schemas/theme-presets.schema.json",
  "$description": "Component presets for website context toy-r-us theme",
  "components": {
    "handsontable": {
      "props": {
        "theme": "ht-theme-main",
        "stretchH": "all",
        "className": "ht-theme-main toy-r-us-variant"
      },
      "layout": {
        "centerContent": true,
        "maxWidth": "1200px"
      },
      "styles": {
        "headerBackground": "{eui.color.surface.primary}",
        "headerTextColor": "{eui.color.text.on-primary}",
        "rowBackground": "{eui.color.surface.secondary}",
        "borderColor": "{eui.color.border.default}"
      },
      "$meta": {
        "description": "Toy R Us themed Handsontable configuration with brand colors",
        "vendor": "handsontable",
        "version": "^16.2.0"
      }
    }
  }
}
